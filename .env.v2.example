# Copy to .env.v2.local (gitignored) for `podman compose -f compose.v2.yaml up`.
# Both containers read this file.

# Shared secret between the portal and the AD service: 24+ random characters.
# Make one:  py -c "import secrets; print(secrets.token_urlsafe(32))"
AD_SERVICE_TOKEN=

# development | production
APP_ENV=development

# Laptop without AD: the demo accounts (admin / admin12345). Never at the office.
DEMO_LOGIN=on

# Two-step verification with an authenticator app: on | off
LOGIN_2FA=on

# --- Active Directory (leave empty on a laptop without AD) -------------------
AD_LDAP_URL=
LDAP_DOMAIN=
AD_BASE_DN=
LDAP_CA_CERT_PATH=
AD_GROUP_HC=
AD_GROUP_ADMIN=
AD_GROUP_OPS=
AD_GROUP_AUDITOR=

# 32 random bytes, base64. Also seals the 2FA secrets: never change it once used.
# Make one:  py -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
OUTBOX_ENCRYPTION_KEY=

NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas
SESSION_IDLE_TTL_MINUTES=120
