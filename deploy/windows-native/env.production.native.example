# Salin ke C:\ProgramData\HCUserManagement\config\production.env.
# Kedua Windows Services membaca file ini. Ganti semua <...>; batasi ACL.
# Format NAMA=nilai tanpa tanda kutip. Simpan secret di luar repo.
APP_ENV=production
AD_SERVICE_URL=http://127.0.0.1:8081
HC_DATA_DIR=C:\ProgramData\HCUserManagement\data

# --- Rahasia bersama (buat sekali, jangan diganti) ----------------------------
# Kunci antara portal dan layanan AD. Buat token dan kunci di bawah dengan
# menjalankan blok ini dua kali; gunakan hasil yang BERBEDA untuk masing-masing:
#   $bytes = New-Object byte[] 32
#   $rng = [Security.Cryptography.RandomNumberGenerator]::Create()
#   try { $rng.GetBytes($bytes) } finally { $rng.Dispose() }
#   [Convert]::ToBase64String($bytes)
AD_SERVICE_TOKEN=<base64-32-byte-acak>
# 32 byte base64. Mengenkripsi antrean email DAN kunci 2FA: jangan diganti
# setelah dipakai, atau semua orang harus mendaftarkan HP lagi. Buat dengan
# blok yang sama seperti di atas, tetapi jalankan sekali lagi untuk hasil baru.
OUTBOX_ENCRYPTION_KEY=<base64-32-byte>

# --- Alamat portal ----------------------------------------------------------
# Alamat https yang dibuka staf HC (lewat IIS). Setiap link persetujuan di
# email dibangun dari nilai ini, jadi harus bisa dibuka dari PC manajer.
APP_BASE_URL=https://<nama-host-portal>
NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas
# Logo di header: berkas di portal/app/static/brand. Kosong = nama saja.
NEXT_PUBLIC_BRAND_LOGO=/brand/mandiri-sekuritas.png

# --- Active Directory: login ------------------------------------------------
# Hanya LDAPS (636), sertifikat diverifikasi dengan CA kantor.
AD_LDAP_URL=ldaps://<nama-host-dc>:636
LDAP_DOMAIN=<domain-upn>
AD_BASE_DN=<base-dn>
LDAP_CA_CERT_PATH=C:\ProgramData\HCUserManagement\certificates\corp-root-ca.pem
LDAP_NESTED_GROUPS=false

# --- Siapa boleh masuk portal (group AD) ------------------------------------
AD_GROUP_HC=<dn-group-hc>
AD_GROUP_ADMIN=<dn-group-admin>
AD_GROUP_OPS=<dn-group-operator>
AD_GROUP_AUDITOR=<dn-group-auditor>

# --- Active Directory: akun layanan (yang membaca & menulis) -----------------
AD_BIND_DN=<dn-akun-service>
AD_BIND_PASSWORD=<kata-sandi-akun-service>
# false dulu. Nyalakan (true) hanya setelah halaman Status sistem semuanya OK.
AD_LDAP_WRITE_ENABLED=false
# Penulisan ditolak di luar OU ini (pisahkan dengan ;).
# Isi induk Kantor Pusat, Kantor Cabang, External, Intern, dan Karantina.
AD_MANAGED_OUS=<dn-ou-kantor-pusat>;<dn-ou-kantor-cabang>;<dn-ou-external>;<dn-ou-intern>;<dn-ou-karantina>
AD_QUARANTINE_OU=<dn-ou-karantina>

# Penempatan akun mengikuti jenis pekerja dan lokasi; grup dasar otomatis.
# Nama sub-OU harus persis mengikuti PANDUAN-AD-OU.md.
AD_OU_ROUTING_MODE=STRUCTURED
AD_OU_INTERNAL_PUSAT_PARENT=<dn-ou-kantor-pusat>
AD_OU_INTERNAL_CABANG_PARENT=<dn-ou-kantor-cabang>
AD_OU_EXTERNAL_PUSAT=<dn-ou-pusat-external>
AD_OU_EXTERNAL_CABANG_PARENT=<dn-ou-cabang-external>
AD_OU_INTERN=<dn-ou-intern>
# Nilai atribut company pada akun yang dibuat portal.
AD_COMPANY_NAME=<nama-perusahaan-di-ad>
# Opsional jika nama OU sebenarnya berbeda dari label formulir.
# Format: label=>nama OU sebenarnya;label=>nama OU sebenarnya
# Contoh setelah dikonfirmasi IT: Makasar=>Makassar;Intren=>Intern
AD_OU_NAME_MAP=

# Grup dasar otomatis untuk akun baru.
AD_ACCESS_GROUP_BASE=<dn-group-akses-dasar>

# Sinkronkan seluruh cabang struktur, termasuk Karantina untuk melacak akun nonaktif.
AD_SYNC_OUS=<dn-ou-kantor-pusat>;<dn-ou-kantor-cabang>;<dn-ou-external>;<dn-ou-intern>;<dn-ou-karantina>
AD_SYNC_MINUTES=15

# --- Persetujuan --------------------------------------------------------------
# Tim CISO: semua anggota group menerima email, jawaban pertama yang berlaku.
CISO_APPROVER_GROUP=<dn-group-ciso>
# Atau daftar:  Nama <email>, Nama <email>
CISO_APPROVER_EMAILS=
CISO_EXCLUDE_EMAILS=
APPROVAL_TOKEN_TTL_HOURS=24

# --- Email --------------------------------------------------------------------
# Terkirim saat itu juga. Halaman Status sistem menguji koneksi dan login SMTP
# (atau token Graph) sungguhan tanpa mengirim email.
# smtp (server email kantor / relay) atau graph (Microsoft 365 lewat Graph).
EMAIL_DRIVER=smtp
SMTP_HOST=<host-smtp>
# 587 (STARTTLS), 465 (TLS langsung), atau 25 untuk relay internal.
SMTP_PORT=587
# Relay kantor tanpa login: kosongkan SMTP_USER DAN SMTP_PASSWORD.
SMTP_USER=<akun-smtp>
SMTP_PASSWORD=<kata-sandi-smtp>
SMTP_SENDER=<alamat-pengirim>
# required = wajib terenkripsi (disarankan). off hanya untuk relay tanpa TLS dan tanpa login.
SMTP_TLS=required
# Isi bila relay memakai sertifikat dari CA kantor (biasanya file yang sama dengan LDAP).
SMTP_CA_CERT_PATH=
# Microsoft 365 yang mematikan login SMTP: pakai EMAIL_DRIVER=graph dan isi
# keempat nilai ini dari app registration (izin aplikasi Mail.Send + admin
# consent). Kosongkan bila memakai smtp.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=
# Harus KOSONG di kantor (production menolaknya).
EMAIL_REDIRECT_TO=
OUTBOX_POLL_SECONDS=30
WORKER_POLL_SECONDS=30

# --- Keamanan login -----------------------------------------------------------
# Verifikasi 2 langkah dengan aplikasi authenticator: on (disarankan) / off.
LOGIN_2FA=on
# Sesi dicocokkan ulang dengan AD tiap N menit (akun nonaktif = keluar). 0 = mati.
SESSION_RECHECK_MINUTES=5
# Sesi berakhir setelah sekian menit tidak dipakai, dan paling lama 8 jam.
SESSION_IDLE_TTL_MINUTES=120
SESSION_ABSOLUTE_TTL_MINUTES=480
# Akun demo selalu mati di production.
DEMO_LOGIN=off

# --- Folder karyawan baru (opsional) ------------------------------------------
USER_FOLDER_ROOT=C:\ProgramData\HCUserManagement\data\user-folders
