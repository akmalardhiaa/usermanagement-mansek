# Copy to .env.dev.local (gitignored) for `podman compose up` on a laptop or PC;
# jalankan-podman.bat makes one with fresh secrets on its first run. Both
# containers read it. Empty means "not used". The office uses
# deploy/windows/env.production.example instead.

# --- Basics -------------------------------------------------------------------
# development | production
APP_ENV=development

# Shared secret between the portal and the AD service: 24+ random characters.
# Make one:  py -c "import secrets; print(secrets.token_urlsafe(32))"
AD_SERVICE_TOKEN=

# 32 random bytes, base64. Seals the email queue and the 2FA secrets: never
# change it once used, or everybody has to register their phone again.
# Make one:  py -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
OUTBOX_ENCRYPTION_KEY=

NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas
# Logo di header: berkas di portal/app/static/brand. Kosong = nama saja.
NEXT_PUBLIC_BRAND_LOGO=/brand/mandiri-sekuritas-lockup.png

# Laptop without AD: demo accounts (admin / admin12345). Refused in production.
DEMO_LOGIN=on

# --- Sign-in --------------------------------------------------------------------
# Two-step verification with an authenticator app: on | off
LOGIN_2FA=on
SESSION_IDLE_TTL_MINUTES=120
SESSION_ABSOLUTE_TTL_MINUTES=480
# How often signed-in people are checked against AD (disabled, left the HC group).
SESSION_RECHECK_MINUTES=5

# --- Active Directory (leave empty on a laptop without AD) ---------------------
# LDAPS only (port 636). The company CA goes in ./certs, read as /run/certs.
AD_LDAP_URL=
LDAP_DOMAIN=
AD_BASE_DN=
LDAP_CA_CERT_PATH=/run/certs/company-ca.pem

# Who may use the portal: members of these groups (DN or CN).
AD_GROUP_HC=
AD_GROUP_ADMIN=
AD_GROUP_OPS=
AD_GROUP_AUDITOR=

# The service account the AD service reads and writes with.
AD_BIND_DN=
AD_BIND_PASSWORD=
# false = read only: requests are approved, but nothing is written to AD.
AD_LDAP_WRITE_ENABLED=false
# Writes are refused outside these OUs (separate with ;). Include the division
# parent and the quarantine OU.
AD_MANAGED_OUS=

# Where accounts go. One OU per division under a parent:
#   AD_DEPARTMENT_OU_PARENT=OU=Divisi,OU=People,DC=corp,DC=example
# gives "OU=Finance,OU=Divisi,..." for Finance. Or name them one by one:
#   AD_DEPARTMENT_OUS=Finance=>OU=Finance,DC=corp,DC=example;Legal=>OU=Legal,DC=corp,DC=example
AD_DEPARTMENT_OU_PARENT=
AD_DEPARTMENT_OUS=
# Disabled accounts (resign / termination) are moved here.
AD_QUARANTINE_OU=
# Per access profile (used when a profile is chosen on the form).
AD_OU_STANDARD=
AD_OU_ENGINEERING=
AD_OU_FINANCE=
AD_OU_SECURITY=
AD_ACCESS_GROUP_BASE=
AD_ACCESS_GROUP_ENGINEERING=
AD_ACCESS_GROUP_FINANCE=
AD_ACCESS_GROUP_SECURITY=

# The directory page is filled from these OUs (separate with ;); empty = AD_BASE_DN.
AD_SYNC_OUS=
AD_SYNC_MINUTES=15
WORKER_POLL_SECONDS=30

# --- Approvals ------------------------------------------------------------------
# The CISO team, first answer wins. Either an AD group (its members with a
# mailbox) or a list: "Name <email>, Name <email>".
CISO_APPROVER_GROUP=
CISO_APPROVER_EMAILS=
CISO_EXCLUDE_EMAILS=
APPROVAL_TOKEN_TTL_HOURS=24

# --- Email ------------------------------------------------------------------------
# smtp at the office; file on a laptop (written to data/outbox-mail, refused in production).
EMAIL_DRIVER=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
# required (STARTTLS, default) | off (only for a relay without TLS, and never with a login)
SMTP_TLS=required
SMTP_CA_CERT_PATH=
# Laptop only: every message to this one inbox instead. Refused in production.
EMAIL_REDIRECT_TO=
OUTBOX_POLL_SECONDS=30
