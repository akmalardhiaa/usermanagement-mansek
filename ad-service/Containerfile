# The AD service (Java). Built inside the container, so the office PC needs no JDK or Maven.
FROM docker.io/library/maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B -q package -DskipTests

FROM docker.io/library/eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/target/ad-service.jar ./ad-service.jar
RUN useradd --system --uid 10002 adservice
USER adservice
EXPOSE 8081
CMD ["java", "-XX:MaxRAMPercentage=60", "-jar", "/app/ad-service.jar"]
